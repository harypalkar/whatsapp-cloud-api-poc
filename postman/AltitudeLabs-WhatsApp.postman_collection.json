      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Company-Id", "value": "{{companyId}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"mobile\": \"917506426501\",\n  \"name\": \"Harish\",\n  \"promoCode\": \"WELCOME100\",\n  \"sendWelcome\": true,\n  \"messageStyle\": \"template\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/customers/onboard"
