{
  "info": {
    "name": "Altitude Labs WhatsApp Cloud API",
    "description": "Production WhatsApp Cloud API — multi-tenant SaaS (X-Company-Id). Graph API v23.0, template altitude_welcome_promo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "companyId", "value": "1" },
    { "key": "customerNumber", "value": "917506426501" },
    { "key": "verifyToken", "value": "AltitudeLabs@2026" }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Send Marketing Template",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Company-Id", "value": "{{companyId}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"mobile\": \"917506426501\",\n  \"customerName\": \"Harish\",\n  \"promoCode\": \"WELCOME100\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/messages/send-template"
      }
    },
