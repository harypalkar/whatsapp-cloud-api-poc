          "raw": "{\n  \"customers\": [\n    { \"mobile\": \"917506426501\", \"name\": \"Harish\", \"promoCode\": \"WELCOME100\", \"messageStyle\": \"template\" },\n    { \"mobile\": \"917718986249\", \"name\": \"Amit\", \"promoCode\": \"WELCOME100\", \"messageStyle\": \"template\" }\n  ]\n}"
