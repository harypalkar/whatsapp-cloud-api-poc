        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"promoCode\": \"WELCOME100\",\n  \"mobiles\": [\n    \"917718986249\",\n    \"917506426501\",\n    \"917718884343\"\n  ]\n}"
